{
  "manifest_version": 2,
  "name": "Lingua Watch – Video Time by Language",
  "short_name": "Lingua Watch",
  "version": "0.1.0",
  "description": "Tracks how much time you spend watching videos in each language on YouTube, Netflix and other sites.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "src/lib/languages.js",
      "src/lib/stats.js",
      "src/background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/lib/languages.js",
        "src/lib/tracker.js",
        "src/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "Lingua Watch",
    "default_popup": "src/popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "src/dashboard/dashboard.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lingua-watch@example.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
